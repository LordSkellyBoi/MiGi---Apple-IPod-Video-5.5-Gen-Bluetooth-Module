diff -urN a/apps/plugins/btpicker.c b/apps/plugins/btpicker.c
--- a/apps/plugins/btpicker.c	1969-12-31 16:00:00.000000000 -0800
+++ b/apps/plugins/btpicker.c	2026-11-03 02:15:00.243415805 -0800
@@ -0,0 +1,278 @@
+/***************************************************************************
+ * Bluetooth picker for the iPod + STM32 Bluetooth transmitter module.
+ *
+ * This plugin is only a menu client. The STM32 firmware decides what the
+ * menu shows and what every selection does, so new features need no Rockbox
+ * rebuild. It talks through the private iAP "BT link" lingo (see
+ * apps/iap/iap-btlink.c).
+ *
+ * All files in this archive are subject to the GNU General Public License.
+ * See the file COPYING in the source tree root for full license agreement.
+ ****************************************************************************/
+#include "plugin.h"
+
+/* ---- frame protocol shared with the STM32 firmware ----------------------
+ * Plugin -> module (first byte = code):
+ *   0x10 OPEN        the plugin has started
+ *   0x11 SELECT      followed by the id of the selected item
+ *   0x12 BACK        Menu/back was pressed
+ *   0x13 CLOSE       the plugin is exiting
+ *   0x14 TICK        sent every 2 s while the plugin is open
+ * Module -> plugin (first byte = code):
+ *   0x90 BEGIN       start of a new screen (resets the pending screen)
+ *   0x91 HEADER      line number (0 or 1), text (not NUL terminated)
+ *   0x92 ITEM        id, flags, text (not NUL terminated)
+ *   0x93 END         show the pending screen
+ *   0x94 EXIT        close the plugin
+ *   0x95 TOAST       text to show for two seconds
+ *   0xA0 PLAYBACK    1 play, 2 pause, 3 next track, 4 previous track
+ */
+#define REQ_OPEN    0x10
+#define REQ_SELECT  0x11
+#define REQ_BACK    0x12
+#define REQ_CLOSE   0x13
+#define REQ_TICK    0x14
+#define EV_BEGIN    0x90
+#define EV_HEADER   0x91
+#define EV_ITEM     0x92
+#define EV_END      0x93
+#define EV_EXIT     0x94
+#define EV_TOAST    0x95
+#define EV_PLAYBACK 0xA0
+
+#define FRAME_MAX   48          /* must match IAP_BTLINK_MAX */
+#define MAX_ITEMS   24
+#define TEXT_LEN    46
+#define HEADER_ROWS 2
+
+struct item {
+    unsigned char id;
+    char text[TEXT_LEN];
+};
+
+static struct item cur[MAX_ITEMS], pend[MAX_ITEMS];
+static int  n_cur, n_pend;
+static char hdr[2][TEXT_LEN], pend_hdr[2][TEXT_LEN];
+static bool have_menu;          /* a screen from the module has been shown */
+static bool want_exit;
+static int  sel, top;
+static unsigned char sel_id;    /* id of the highlighted item, kept across redraws */
+static long back_deadline;      /* 0 = none; leave locally if the module never answers a BACK */
+
+static void send_request(unsigned char code, int arg)
+{
+    unsigned char f[2];
+    int n = 0;
+
+    f[n++] = code;
+    if (arg >= 0)
+        f[n++] = (unsigned char)arg;
+    rb->iap_btlink_send(f, n);
+}
+
+static void copy_text(char *dst, const unsigned char *src, int n)
+{
+    int i;
+
+    if (n > TEXT_LEN - 1)
+        n = TEXT_LEN - 1;
+    for (i = 0; i < n; i++)
+        dst[i] = (src[i] >= 32 && src[i] < 127) ? (char)src[i] : '?';
+    dst[n] = '\0';
+}
+
+/* the pending screen is complete: show it, keeping the highlight on the same item if it still exists */
+static void commit_screen(void)
+{
+    int i, found = -1;
+
+    for (i = 0; i < n_pend; i++) {
+        if (sel_id != 0 && pend[i].id == sel_id) {
+            found = i;
+            break;
+        }
+    }
+    rb->memcpy(cur, pend, sizeof(struct item) * n_pend);
+    n_cur = n_pend;
+    rb->memcpy(hdr, pend_hdr, sizeof hdr);
+    if (found >= 0) {
+        sel = found;
+    } else {
+        sel = 0;
+        top = 0;
+    }
+    if (n_cur > 0)
+        sel_id = cur[sel].id;
+    have_menu = true;
+    back_deadline = 0;
+}
+
+static void do_playback(unsigned char cmd)
+{
+    int status = rb->audio_status();
+
+    switch (cmd) {
+    case 1:                     /* play */
+        if (status & AUDIO_STATUS_PAUSE)
+            rb->audio_resume();
+        break;
+    case 2:                     /* pause */
+        if ((status & AUDIO_STATUS_PLAY) && !(status & AUDIO_STATUS_PAUSE))
+            rb->audio_pause();
+        break;
+    case 3:
+        rb->audio_next();
+        break;
+    case 4:
+        rb->audio_prev();
+        break;
+    }
+}
+
+static void handle_frame(const unsigned char *f, int n)
+{
+    switch (f[0]) {
+    case EV_BEGIN:
+        n_pend = 0;
+        pend_hdr[0][0] = pend_hdr[1][0] = '\0';
+        break;
+    case EV_HEADER:
+        if (n >= 2 && f[1] < 2)
+            copy_text(pend_hdr[f[1]], &f[2], n - 2);
+        break;
+    case EV_ITEM:               /* f[1]=id, f[2]=flags, f[3..]=text */
+        if (n >= 3 && n_pend < MAX_ITEMS) {
+            pend[n_pend].id = f[1];
+            copy_text(pend[n_pend].text, &f[3], n - 3);
+            n_pend++;
+        }
+        break;
+    case EV_END:
+        commit_screen();
+        break;
+    case EV_EXIT:
+        want_exit = true;
+        break;
+    case EV_TOAST:
+        if (n >= 2) {
+            char msg[TEXT_LEN];
+            copy_text(msg, &f[1], n - 1);
+            rb->splashf(HZ * 2, "%s", msg);
+        }
+        break;
+    case EV_PLAYBACK:
+        if (n >= 2)
+            do_playback(f[1]);
+        break;
+    }
+}
+
+static void draw(int visible)
+{
+    int i;
+
+    rb->lcd_clear_display();
+    if (!have_menu) {
+        rb->lcd_putsf(0, 0, "Bluetooth: waiting for module...");
+    } else {
+        rb->lcd_putsf(0, 0, "%s", hdr[0]);
+        rb->lcd_putsf(0, 1, "%s", hdr[1]);
+        for (i = 0; i < visible && top + i < n_cur; i++)
+            rb->lcd_putsf(0, HEADER_ROWS + i, "%c %s",
+                          (top + i == sel) ? '>' : ' ', cur[top + i].text);
+    }
+    rb->lcd_update();
+}
+
+enum plugin_status plugin_start(const void *parameter)
+{
+    unsigned char f[FRAME_MAX];
+    int visible, w, h, n;
+    long next_tick;
+
+    (void)parameter;
+
+    rb->lcd_getstringsize("A", &w, &h);
+    if (h < 1)
+        h = 8;
+    visible = LCD_HEIGHT / h - HEADER_ROWS;
+    if (visible < 2)
+        visible = 2;
+
+    n_cur = n_pend = 0;
+    have_menu = want_exit = false;
+    sel = top = 0;
+    sel_id = 0;
+    back_deadline = 0;
+
+    send_request(REQ_OPEN, -1);
+    next_tick = *rb->current_tick + 2 * HZ;
+
+    while (1) {
+        int action;
+
+        while ((n = rb->iap_btlink_recv(f, sizeof f)) > 0)
+            handle_frame(f, n);
+
+        if (want_exit)
+            break;
+        if (back_deadline && (long)(*rb->current_tick - back_deadline) >= 0)
+            break;              /* the module did not answer BACK: do not trap the user here */
+
+        /* keep-alive every 2 s; until the module has shown a screen, ask again */
+        if ((long)(*rb->current_tick - next_tick) >= 0) {
+            send_request(have_menu ? REQ_TICK : REQ_OPEN, -1);
+            next_tick = *rb->current_tick + 2 * HZ;
+        }
+
+        if (sel >= n_cur)
+            sel = n_cur > 0 ? n_cur - 1 : 0;
+        if (sel < top)
+            top = sel;
+        if (sel >= top + visible)
+            top = sel - visible + 1;
+
+        draw(visible);
+
+        action = rb->get_action(CONTEXT_LIST, HZ / 10);
+        switch (action) {
+        case ACTION_STD_PREV:
+        case ACTION_STD_PREVREPEAT:
+            if (sel > 0)
+                sel--;
+            if (n_cur > 0)
+                sel_id = cur[sel].id;
+            break;
+        case ACTION_STD_NEXT:
+        case ACTION_STD_NEXTREPEAT:
+            if (sel < n_cur - 1)
+                sel++;
+            if (n_cur > 0)
+                sel_id = cur[sel].id;
+            break;
+        case ACTION_STD_OK:
+            if (have_menu && n_cur > 0)
+                send_request(REQ_SELECT, cur[sel].id);
+            break;
+        case ACTION_STD_CANCEL:
+            if (!have_menu) {
+                want_exit = true;
+            } else {
+                send_request(REQ_BACK, -1);
+                back_deadline = *rb->current_tick + 2 * HZ;
+            }
+            break;
+        default:
+            if (rb->default_event_handler(action) == SYS_USB_CONNECTED) {
+                send_request(REQ_CLOSE, -1);
+                return PLUGIN_USB_CONNECTED;
+            }
+            break;
+        }
+        if (want_exit)
+            break;
+    }
+
+    send_request(REQ_CLOSE, -1);
+    return PLUGIN_OK;
+}
