diff -urN a/apps/iap/iap-btlink.c b/apps/iap/iap-btlink.c
--- a/apps/iap/iap-btlink.c	1969-12-31 16:00:00.000000000 -0800
+++ b/apps/iap/iap-btlink.c	2026-11-03 02:15:00.235484369 -0800
@@ -0,0 +1,142 @@
+/***************************************************************************
+ * Private "BT link" lingo for talking to an external Bluetooth accessory.
+ * See iap-btlink.h.
+ *
+ * All files in this archive are subject to the GNU General Public License.
+ * See the file COPYING in the source tree root for full license agreement.
+ ****************************************************************************/
+#include <stdint.h>
+#include <string.h>
+#include "system.h"
+#include "audio.h"
+#include "iap-core.h"
+#include "iap-btlink.h"
+
+#define BTLINK_RX_DEPTH  16     /* frames from the accessory, waiting for the plugin */
+#define BTLINK_TX_DEPTH  4      /* frames from the plugin, waiting to be sent */
+
+struct btlink_frame {
+    uint8_t len;
+    uint8_t data[IAP_BTLINK_MAX];
+};
+
+static struct btlink_frame rx_q[BTLINK_RX_DEPTH];
+static volatile uint8_t rx_head, rx_tail;     /* iap thread writes head, plugin reads tail */
+
+static struct btlink_frame tx_q[BTLINK_TX_DEPTH];
+static volatile uint8_t tx_head, tx_tail;     /* plugin writes head, iap thread reads tail */
+
+#define BTLINK_PLAYBACK  0xA0   /* accessory -> iPod: play (1), pause (2), next track (3), previous track (4) */
+
+/* Carried out right here in the iap thread, so it works with the Hold switch on and without the plugin
+ * (iPod button events are ignored while Hold is on). */
+static void btlink_playback(unsigned char cmd)
+{
+    int status = audio_status();
+
+    switch (cmd) {
+    case 1:
+        if (status & AUDIO_STATUS_PAUSE)
+            audio_resume();
+        break;
+    case 2:
+        if ((status & AUDIO_STATUS_PLAY) && !(status & AUDIO_STATUS_PAUSE))
+            audio_pause();
+        break;
+    case 3:
+        audio_next();
+        break;
+    case 4:
+        audio_prev();
+        break;
+    }
+}
+
+/* iap thread: a packet for our lingo arrived. buf[0] is the lingo byte. */
+void iap_handlepkt_btlink(const unsigned int len, const unsigned char *buf)
+{
+    unsigned int n;
+    uint8_t next;
+    int level;
+
+    if (len < 2)                    /* lingo byte plus at least one payload byte */
+        return;
+    if (buf[1] == BTLINK_PLAYBACK) {    /* playback command: do it now, the plugin never sees it */
+        if (len >= 3)
+            btlink_playback(buf[2]);
+        return;
+    }
+    n = len - 1;
+    if (n > IAP_BTLINK_MAX)         /* too long, drop */
+        return;
+
+    level = disable_irq_save();
+    next = (uint8_t)((rx_head + 1) % BTLINK_RX_DEPTH);
+    if (next != rx_tail) {          /* if the queue is full the frame is dropped */
+        memcpy(rx_q[rx_head].data, buf + 1, n);
+        rx_q[rx_head].len = (uint8_t)n;
+        rx_head = next;
+    }
+    restore_irq(level);
+}
+
+int iap_btlink_recv(unsigned char *buf, int maxlen)
+{
+    int n = 0;
+    int level;
+
+    if (maxlen <= 0)
+        return 0;
+
+    level = disable_irq_save();
+    if (rx_tail != rx_head) {
+        n = rx_q[rx_tail].len;
+        if (n > maxlen)
+            n = maxlen;
+        memcpy(buf, rx_q[rx_tail].data, n);
+        rx_tail = (uint8_t)((rx_tail + 1) % BTLINK_RX_DEPTH);
+    }
+    restore_irq(level);
+    return n;
+}
+
+int iap_btlink_send(const unsigned char *data, int len)
+{
+    uint8_t next;
+    int level;
+    int ret = -1;
+
+    if (len < 1 || len > IAP_BTLINK_MAX)
+        return -1;
+
+    level = disable_irq_save();
+    next = (uint8_t)((tx_head + 1) % BTLINK_TX_DEPTH);
+    if (next != tx_tail) {
+        memcpy(tx_q[tx_head].data, data, len);
+        tx_q[tx_head].len = (uint8_t)len;
+        tx_head = next;
+        ret = 0;
+    }
+    restore_irq(level);
+    return ret;
+}
+
+/* iap thread, every 100 ms: transmit queued frames. Sending only from the
+ * iap thread keeps the shared TX buffer (iap_txnext) race-free. */
+void iap_btlink_periodic(void)
+{
+    if (iap_txpayload == NULL)      /* buffers not allocated yet */
+        return;
+
+    while (tx_tail != tx_head) {
+        const struct btlink_frame *f = &tx_q[tx_tail];
+
+        if ((int)f->len + 1 <= TX_BUFLEN) {
+            iap_txnext = iap_txpayload;
+            IAP_TX_PUT(IAP_LINGO_BTLINK);
+            IAP_TX_PUT_DATA(f->data, f->len);
+            iap_send_tx();
+        }
+        tx_tail = (uint8_t)((tx_tail + 1) % BTLINK_TX_DEPTH);
+    }
+}
diff -urN a/apps/iap/iap-btlink.h b/apps/iap/iap-btlink.h
--- a/apps/iap/iap-btlink.h	1969-12-31 16:00:00.000000000 -0800
+++ b/apps/iap/iap-btlink.h	2026-11-03 02:15:00.232139293 -0800
@@ -0,0 +1,35 @@
+/***************************************************************************
+ * Private "BT link" lingo: lets a plugin talk to an external accessory
+ * (an STM32 + Bluetooth module) over the iPod's iAP serial port.
+ *
+ * Frames travel in ordinary iAP packets:  FF 55 <len> 1E <payload...> <chk>
+ * The first payload byte is a command/event code defined by the plugin and
+ * the accessory firmware; this layer just carries the bytes.
+ *
+ * All files in this archive are subject to the GNU General Public License.
+ * See the file COPYING in the source tree root for full license agreement.
+ ****************************************************************************/
+#ifndef _IAP_BTLINK_H
+#define _IAP_BTLINK_H
+
+/* Private lingo ID (not used by any Apple-defined lingo Rockbox implements) */
+#define IAP_LINGO_BTLINK  0x1E
+
+/* Maximum payload bytes per frame (excluding the lingo byte) */
+#define IAP_BTLINK_MAX    48
+
+/* iap thread: handle a received packet. buf[0] is the lingo byte. */
+void iap_handlepkt_btlink(const unsigned int len, const unsigned char *buf);
+
+/* iap thread: called every 100 ms, sends any frames queued by plugins */
+void iap_btlink_periodic(void);
+
+/* Any thread: queue a frame for the accessory. Returns 0 on success,
+ * -1 if the frame is too long or the queue is full. */
+int iap_btlink_send(const unsigned char *data, int len);
+
+/* Any thread: fetch the next frame from the accessory into buf (at most
+ * maxlen bytes). Returns the number of bytes, or 0 if none is waiting. */
+int iap_btlink_recv(unsigned char *buf, int maxlen);
+
+#endif /* _IAP_BTLINK_H */
